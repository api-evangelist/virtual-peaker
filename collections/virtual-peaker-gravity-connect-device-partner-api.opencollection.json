              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint is used to enable or disable the publishing of device data (signals and settings) to Virtual Peaker."
        }
